{
    "name": "preprio/laravel-rest-sdk",
    "description": "Laravel SDK for the Prepr REST API.",
    "keywords": ["laravel", "prepr", "rest"],
    "license": "MIT",
    "authors": [
        {
            "name": "Prepr",
            "email": "support@prepr.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.3|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },

    "autoload": {
        "psr-4": {
            "Preprio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preprio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Preprio\\PreprServiceProvider"
            ],
            "aliases": {
                "Prepr": "Preprio\\PreprFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
